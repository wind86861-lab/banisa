generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  phone              String              @unique
  email              String?
  passwordHash       String
  firstName          String?
  lastName           String?
  role               Role                @default(PATIENT)
  status             UserStatus          @default(PENDING)
  isActive           Boolean             @default(true)
  // Default / "primary" clinic for backwards compatibility with code that
  // still reads User.clinicId directly. The authoritative membership list is
  // ClinicMembership; this column is the first one created in that table.
  clinicId           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  appointments       Appointment[]
  cartItems          CartItem[]
  diagnosticServices DiagnosticService[] @relation("CreatedBy")
  reviews            Review[]
  sanatoriumServices SanatoriumService[] @relation("SanatoriumCreatedBy")
  serviceReviews     ServiceReview[]
  surgicalServices   SurgicalService[]   @relation("SurgicalCreatedBy")
  notifications      Notification[]      @relation("UserNotifications")
  favorites          UserFavorite[]
  doctorReviews      DoctorReview[]
  notificationPreference NotificationPreference?
  notificationLogs      NotificationLog[]
  telegramAccount       TelegramAccount?
  telegramLoginTokens   TelegramLoginToken[]
  clinicMemberships     ClinicMembership[]
  clinicMembershipsInvited ClinicMembership[] @relation("InvitedBy")
  clinicAuditEntries    ClinicAuditLog[]   @relation("ClinicAuditActor")

  @@index([phone])
  @@index([status])
  @@index([role])
}

/// Per-user bookmark of a public service (any service type).
model UserFavorite {
  id          String      @id @default(uuid())
  userId      String
  serviceType ServiceType
  serviceId   String
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceType, serviceId])
  @@index([userId, createdAt])
  @@index([serviceType, serviceId])
}

model ServiceCategory {
  id                 String              @id @default(uuid())
  parentId           String?
  level              Int                 @default(0)
  nameUz             String
  nameRu             String?
  nameEn             String?
  slug               String              @unique
  icon               String?
  imageUrl           String?
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  diagnosticServices DiagnosticService[]
  sanatoriumServices SanatoriumService[]
  parent             ServiceCategory?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children           ServiceCategory[]   @relation("CategoryHierarchy")
  surgicalServices   SurgicalService[]
}

model DiagnosticService {
  id                    String                    @id @default(uuid())
  nameUz                String
  nameRu                String?
  nameEn                String?
  categoryId            String
  shortDescription      String?                   @db.VarChar(200)
  fullDescription       String?
  priceRecommended      Int                       @default(0)
  priceMin              Int                       @default(0)
  priceMax              Int                       @default(0)
  durationMinutes       Int                       @default(30)
  resultTimeHours       Float                     @default(24)
  preparation           String?
  contraindications     String?
  sampleType            String?                   @db.VarChar(100)
  imageUrl              String?
  isActive              Boolean                   @default(true)
  createdById           String
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  additionalInfo        Json?
  bookingPolicy         Json?
  contraindicationsJson Json?
  indicationsJson       Json?
  preparationJson       Json?
  processDescription    String?
  resultFormat          String?                   @db.VarChar(200)
  resultParameters      Json?
  sampleVolume          String?                   @db.VarChar(50)
  appointments          Appointment[]             @relation("DiagnosticServiceAppointments")
  clinicLinks           ClinicDiagnosticService[] @relation("DiagnosticServiceClinicLinks")
  category              ServiceCategory           @relation(fields: [categoryId], references: [id])
  createdBy             User                      @relation("CreatedBy", fields: [createdById], references: [id])
  serviceReviews        ServiceReview[]

  @@index([categoryId])
  @@index([isActive])
  @@index([priceRecommended])
}

model SurgicalService {
  id                        String                  @id @default(uuid())
  nameUz                    String
  nameRu                    String?
  nameEn                    String?
  categoryId                String
  shortDescription          String?                 @db.VarChar(200)
  fullDescription           String?
  imageUrl                  String?
  priceRecommended          Int
  priceMin                  Int
  priceMax                  Int
  durationMinutes           Int                     @default(0)
  minDuration               Int?
  maxDuration               Int?
  recoveryDays              Int                     @default(0)
  anesthesiaType            AnesthesiaType
  anesthesiaNotes           String?
  requiresHospitalization   Boolean                 @default(true)
  hospitalizationDays       Int?
  roomType                  RoomType?
  requiresICU               Boolean                 @default(false)
  icuDays                   Int?
  hospitalizationNotes      String?
  requiredTests             Json?
  preparationFasting        Boolean                 @default(false)
  fastingHours              Int?
  preparationMedication     String?
  preparationRestrictions   Json?
  preparationTimeline       String?
  contraindicationsAbsolute Json?
  contraindicationsRelative Json?
  complexity                Complexity
  riskLevel                 RiskLevel
  minSurgeonExperience      Int                     @default(0)
  surgeonQualifications     Json?
  surgeonSpecialization     String?
  requiredEquipment         Json?
  operationStages           Json?
  postOpImmediate           Json?
  postOpHome                Json?
  followUpSchedule          Json?
  recoveryMilestones        Json?
  packageIncluded           Json?
  packageExcluded           Json?
  alternatives              Json?
  faqs                      Json?
  successRate               Float?
  videoUrl                  String?
  isActive                  Boolean                 @default(true)
  createdById               String
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  appointments              Appointment[]           @relation("SurgicalServiceAppointments")
  clinicLinks               ClinicSurgicalService[] @relation("SurgicalServiceClinicLinks")
  serviceReviews            ServiceReview[]
  category                  ServiceCategory         @relation(fields: [categoryId], references: [id])
  createdBy                 User                    @relation("SurgicalCreatedBy", fields: [createdById], references: [id])

  @@index([categoryId])
  @@index([isActive])
  @@index([complexity])
  @@index([riskLevel])
}

model Clinic {
  id                     String                    @id @default(uuid())
  nameUz                 String
  nameRu                 String?
  nameEn                 String?
  type                   ClinicType                @default(GENERAL)
  status                 ClinicStatus              @default(PENDING)
  description            String?
  logo                   String?
  coverImage             String?
  region                 String
  district               String
  street                 String
  apartment              String?
  landmark               String?
  latitude               Float?
  longitude              Float?
  phones                 Json                      @default("[]")
  emails                 Json                      @default("[]")
  website                String?
  socialMedia            Json?
  workingHours           Json                      @default("[]")
  hasEmergency           Boolean                   @default(false)
  hasAmbulance           Boolean                   @default(false)
  hasOnlineBooking       Boolean                   @default(true)
  bedsCount              Int?
  floorsCount            Int?
  parkingAvailable       Boolean                   @default(false)
  amenities              Json?
  paymentMethods         Json?
  insuranceAccepted      Json?
  priceRange             String?
  averageRating          Float?                    @default(0)
  reviewCount            Int                       @default(0)
  registrationNumber     String?
  taxId                  String?
  licenseNumber          String?
  licenseIssuedAt        DateTime?
  licenseExpiresAt       DateTime?
  licenseIssuedBy        String?
  adminFirstName         String?
  adminLastName          String?
  adminEmail             String?
  adminPhone             String?
  adminPosition          String?
  rejectionReason        String?
  notes                  String?
  approvedById           String?
  isActive               Boolean                   @default(true)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  createdBy              String?
  pendingPersons         Json?
  reviewedAt             DateTime?
  reviewedBy             String?
  source                 ClinicSource              @default(ADMIN_CREATED)
  submittedAt            DateTime?
  legalForm              String?
  legalName              String?
  legalAddress           String?
  foundedYear            Int?
  descriptionRu          String?
  addressUz              String?
  addressRu              String?
  zipCode                String?
  googleMapsUrl          String?
  isAlwaysOpen           Boolean                   @default(false)
  lunchBreakStart        String?
  lunchBreakEnd          String?
  holidayNotes           String?
  licenseUrl             String?
  certificates           Json?                     @default("[]")
  bankName               String?
  bankAccountNumber      String?
  mfo                    String?
  oked                   String?
  vatNumber              String?
  invoiceEmail           String?
  commissionRate         Float                     @default(0.10)
  defaultDiscountPercent Int                       @default(0)
  checkInSecret          String?                   @unique
  appointments           Appointment[]
  cartItems              CartItem[]
  checkupPackages        ClinicCheckupPackage[]
  diagnosticServices     ClinicDiagnosticService[]
  sanatoriumServices     ClinicSanatoriumService[]
  surgicalServices       ClinicSurgicalService[]
  doctors                Doctor[]
  reviews                Review[]
  notifications          Notification[]            @relation("ClinicNotifications")
  serviceMetadata        ClinicServiceMetadata[]
  paymeConfig            ClinicPaymeConfig?
  paymeConfigVersions    PaymeConfigVersion[]
  paymeTransactions      PaymeTransaction[]
  doctorClinics          DoctorClinic[]
  ambulances             Ambulance[]
  memberships            ClinicMembership[]
  roles                  ClinicRole[]
  auditLog               ClinicAuditLog[]

  @@index([status])
  @@index([source])
  @@index([region])
  @@index([type])
  @@index([createdAt])
}

model Doctor {
  id                String        @id @default(uuid())
  // Legacy primary clinic — kept nullable for backward compatibility.
  // The real source of truth for "which clinics" is DoctorClinic junction.
  clinicId          String?
  firstName         String
  lastName          String
  // Legacy free-text specialty kept for backward compat.
  specialty         String?
  // New: FK into Specialty catalog managed by super-admin.
  specialtyId       String?
  bio               String?
  bioRu             String?
  bioEn             String?
  photoUrl          String?
  photoUrls         Json     @default("[]")
  phone             String?
  email             String?
  yearsExperience   Int?
  averageRating     Float?        @default(0)
  reviewCount       Int           @default(0)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  appointments      Appointment[]
  clinic            Clinic?       @relation(fields: [clinicId], references: [id])
  specialtyRef      Specialty?    @relation(fields: [specialtyId], references: [id])
  doctorClinics     DoctorClinic[]
  reviews           DoctorReview[]

  @@index([clinicId])
  @@index([specialtyId])
  @@index([isActive])
  @@index([averageRating])
}

// ─── Specialty catalog — super-admin managed ────────────────────────────────
model Specialty {
  id        String   @id @default(uuid())
  slug      String   @unique
  nameUz    String
  nameRu    String?
  nameEn    String?
  icon      String?   // lucide icon name or URL
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctors   Doctor[]

  @@index([isActive])
  @@index([sortOrder])
}

// ─── Doctor-Clinic junction (multi-clinic, max 3 enforced app-level) ────────
model DoctorClinic {
  id                String   @id @default(uuid())
  doctorId          String
  clinicId          String
  consultationPrice Int      @default(0)   // per-clinic price
  roomNumber        String?
  isActive          Boolean  @default(true)
  joinedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  doctor    Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic    Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  schedules DoctorSchedule[]
  timeOffs  DoctorTimeOff[]

  @@unique([doctorId, clinicId])
  @@index([doctorId])
  @@index([clinicId])
  @@index([isActive])
}

// ─── Weekly recurring schedule per (doctor, clinic) ─────────────────────────
model DoctorSchedule {
  id               String   @id @default(uuid())
  doctorClinicId   String
  dayOfWeek        Int      // 0=Sun, 1=Mon, ... 6=Sat
  startTime        String   // HH:MM (local clinic time)
  endTime          String   // HH:MM
  slotDurationMin  Int      @default(30)
  breakStart       String?  // HH:MM
  breakEnd         String?  // HH:MM
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  doctorClinic DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)

  @@index([doctorClinicId])
  @@index([dayOfWeek])
}

// ─── One-off time off (vacation, sick, conference) ──────────────────────────
model DoctorTimeOff {
  id              String   @id @default(uuid())
  doctorClinicId  String
  startAt         DateTime
  endAt           DateTime
  reason          String?
  createdAt       DateTime @default(now())

  doctorClinic DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)

  @@index([doctorClinicId])
  @@index([startAt, endAt])
}

// ─── Patient review of a doctor (1 per appointment) ─────────────────────────
model DoctorReview {
  id            String   @id @default(uuid())
  doctorId      String
  patientId     String
  appointmentId String   @unique
  clinicId      String   // denormalized — for fast clinic-rating aggregation
  rating        Int      // 1..5
  comment       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient     User        @relation(fields: [patientId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([doctorId])
  @@index([clinicId])
  @@index([patientId])
  @@index([rating])
  @@index([isActive])
}

model Appointment {
  id                    String                 @id @default(uuid())
  clinicId              String
  patientId             String
  doctorId              String?
  serviceType           AppointmentServiceType @default(OTHER)
  diagnosticServiceId   String?
  surgicalServiceId     String?
  scheduledAt           DateTime
  status                AppointmentStatus      @default(PENDING)
  price                 Int                    @default(0)
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  bookingNumber         String                 @unique
  cancellationReason    String?
  cancelledAt           DateTime?
  cancelledBy           String?
  checkedInAt           DateTime?
  checkedInById         String?
  clinicNotes           String?
  clinicRespondedAt     DateTime?
  clinicRespondedById   String?
  commissionAmount      Int?
  commissionRate        Float?
  completedAt           DateTime?
  completedById         String?
  confirmedByOperatorId String?
  discountAmount        Int                    @default(0)
  discountPercent       Int                    @default(0)
  finalPrice            Int                    @default(0)
  noShowMarkedAt        DateTime?
  noShowMarkedById      String?
  operatorCallNote      String?
  operatorConfirmedAt   DateTime?
  paidAmount            Int?
  paidAt                DateTime?
  paymeTransactionId    String?
  paymentMethod         PaymentMethod?
  paymentStatus         PaymentStatus          @default(UNPAID)
  qrActivatedAt         DateTime?
  qrToken               String?                @unique
  startedAt             DateTime?
  checkInLat            Float?
  checkInLng            Float?
  checkInMethod         String?
  cashConfirmedById     String?
  cashConfirmedAt       DateTime?
  cashReceivedAmount    Int?
  cashAdjustmentNote    String?
  ofertaVersionId       String?
  ofertaAcceptedAt      DateTime?
  reminder24hSentAt     DateTime?
  reminder1hSentAt      DateTime?
  clinic                Clinic                 @relation(fields: [clinicId], references: [id])
  diagnosticService     DiagnosticService?     @relation("DiagnosticServiceAppointments", fields: [diagnosticServiceId], references: [id])
  doctor                Doctor?                @relation(fields: [doctorId], references: [id])
  patient               User                   @relation(fields: [patientId], references: [id])
  surgicalService       SurgicalService?       @relation("SurgicalServiceAppointments", fields: [surgicalServiceId], references: [id])
  ofertaVersion         OfertaVersion?         @relation(fields: [ofertaVersionId], references: [id])
  services              AppointmentService[]
  logs                  AppointmentLog[]
  metadata              AppointmentMetadata[]
  doctorReview          DoctorReview?

  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([scheduledAt])
  @@index([bookingNumber])
  @@index([qrToken])
  @@index([paymentStatus])
}

model AppointmentService {
  id                  String   @id @default(uuid())
  appointmentId       String
  serviceType         AppointmentServiceType
  serviceName         String
  originalServiceId   String?  // references DiagnosticService.id or SurgicalService.id
  price               Int      @default(0)
  finalPrice          Int      @default(0)
  discountAmount      Int      @default(0)
  createdAt           DateTime @default(now())

  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model AppointmentLog {
  id            String      @id @default(uuid())
  appointmentId String
  action        String
  oldStatus     String?
  newStatus     String?
  userId        String?
  userRole      String?
  userName      String?
  note          String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([createdAt])
}

model Review {
  id        String   @id @default(uuid())
  clinicId  String
  userId    String
  rating    Float
  comment   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([clinicId, userId])
  @@index([clinicId])
  @@index([userId])
  @@index([rating])
  @@index([isActive])
}

model ServiceReview {
  id                  String             @id @default(uuid())
  userId              String
  diagnosticServiceId String?
  surgicalServiceId   String?
  sanatoriumServiceId String?
  rating              Int
  comment             String?
  status              ReviewStatus       @default(PENDING)
  reviewedBy          String?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  diagnosticService   DiagnosticService? @relation(fields: [diagnosticServiceId], references: [id])
  sanatoriumService   SanatoriumService? @relation(fields: [sanatoriumServiceId], references: [id])
  surgicalService     SurgicalService?   @relation(fields: [surgicalServiceId], references: [id])
  user                User               @relation(fields: [userId], references: [id])

  @@index([diagnosticServiceId])
  @@index([surgicalServiceId])
  @@index([sanatoriumServiceId])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
}

model ClinicDiagnosticService {
  clinicId            String
  diagnosticServiceId String
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  id                  String                @id @default(uuid())
  clinic              Clinic                @relation(fields: [clinicId], references: [id])
  diagnosticService   DiagnosticService     @relation("DiagnosticServiceClinicLinks", fields: [diagnosticServiceId], references: [id])
  customization       ServiceCustomization?

  @@unique([clinicId, diagnosticServiceId])
  @@index([clinicId])
  @@index([diagnosticServiceId])
  @@index([isActive])
}

model ServiceCustomization {
  id                       String                  @id @default(uuid())
  clinicServiceId          String                  @unique
  customNameUz             String?
  customNameRu             String?
  customDescriptionUz      String?
  customDescriptionRu      String?
  benefits                 Json?
  preparationUz            String?
  preparationRu            String?
  customCategory           String?
  tags                     String[]
  estimatedDurationMinutes Int?
  availableDays            String[]
  availableTimeSlots       Json?
  requiresAppointment      Boolean                 @default(true)
  requiresPrepayment       Boolean                 @default(false)
  prepaymentPercentage     Int?
  isHighlighted            Boolean                 @default(false)
  displayOrder             Int?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  customPrice              Int?
  discountPercent          Int?
  accuracy                 String?                 @db.VarChar(50)
  additionalInfo           Json?
  bookingPolicy            Json?
  certifications           Json?
  equipment                String?                 @db.VarChar(200)
  fullDescriptionRu        String?
  fullDescriptionUz        String?
  preparationJson          Json?
  processDescription       String?
  resultFormat             String?                 @db.VarChar(200)
  resultTimeHours          Float?
  sampleVolume             String?                 @db.VarChar(50)
  clinicService            ClinicDiagnosticService @relation(fields: [clinicServiceId], references: [id], onDelete: Cascade)
  images                   ServiceImage[]

  @@index([clinicServiceId])
  @@index([customCategory])
  @@index([isHighlighted])
  @@index([displayOrder])
}

model ServiceImage {
  id              String               @id @default(uuid())
  customizationId String
  url             String
  alt             String?
  order           Int                  @default(0)
  isPrimary       Boolean              @default(false)
  uploadedAt      DateTime             @default(now())
  customization   ServiceCustomization @relation(fields: [customizationId], references: [id], onDelete: Cascade)

  @@index([customizationId])
  @@index([order])
  @@index([isPrimary])
}

model ClinicSurgicalService {
  clinicId          String
  surgicalServiceId String
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  customizationData Json?
  serviceImages     Json?
  clinic            Clinic          @relation(fields: [clinicId], references: [id])
  surgicalService   SurgicalService @relation("SurgicalServiceClinicLinks", fields: [surgicalServiceId], references: [id])

  @@id([clinicId, surgicalServiceId])
  @@index([clinicId])
  @@index([surgicalServiceId])
  @@index([isActive])
}

model CheckupPackage {
  id               String                 @id @default(cuid())
  nameUz           String
  nameRu           String?
  nameEn           String?
  slug             String                 @unique
  category         CheckupCategory
  shortDescription String?                @db.VarChar(200)
  fullDescription  String?
  targetAudience   String?                @db.VarChar(100)
  recommendedPrice Int
  priceMin         Int
  priceMax         Int
  discount         Int?
  imageUrl         String?
  isActive         Boolean                @default(true)
  createdById      String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  items            CheckupPackageItem[]
  clinicPackages   ClinicCheckupPackage[]

  @@index([category])
  @@index([isActive])
  @@index([slug])
}

model CheckupPackageItem {
  id                  String         @id @default(cuid())
  packageId           String
  diagnosticServiceId String
  serviceName         String
  servicePrice        Int
  quantity            Int            @default(1)
  isRequired          Boolean        @default(true)
  notes               String?        @db.VarChar(255)
  sortOrder           Int            @default(0)
  package             CheckupPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([diagnosticServiceId])
}

model ClinicCheckupPackage {
  id                String         @id @default(cuid())
  clinicId          String
  packageId         String
  clinicPrice       Int
  itemPrices        Json?          // { [packageItemId: string]: priceInUZS } — clinic's per-item prices. Sum == clinicPrice.
  customNotes       String?
  customizationData Json?
  isActive          Boolean        @default(true)
  bookingCount      Int            @default(0)
  activatedAt       DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  clinic            Clinic         @relation(fields: [clinicId], references: [id])
  package           CheckupPackage @relation(fields: [packageId], references: [id])

  @@unique([clinicId, packageId])
  @@index([clinicId])
  @@index([packageId])
  @@index([isActive])
}

model SanatoriumService {
  id                String                    @id @default(uuid())
  nameUz            String
  nameRu            String?
  nameEn            String?
  categoryId        String
  shortDescription  String?                   @db.VarChar(200)
  fullDescription   String?
  imageUrl          String?
  serviceType       SanatoriumServiceType
  priceRecommended  Int                       @default(0)
  priceMin          Int                       @default(0)
  priceMax          Int                       @default(0)
  pricePer          String                    @default("session")
  durationMinutes   Int                       @default(0)
  durationDays      Int?
  sessionsCount     Int?
  capacity          Int?
  includes          Json?
  contraindications String?
  preparation       String?
  isActive          Boolean                   @default(true)
  createdById       String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  clinicLinks       ClinicSanatoriumService[] @relation("SanatoriumServiceClinicLinks")
  category          ServiceCategory           @relation(fields: [categoryId], references: [id])
  createdBy         User                      @relation("SanatoriumCreatedBy", fields: [createdById], references: [id])
  serviceReviews    ServiceReview[]

  @@index([categoryId])
  @@index([isActive])
  @@index([serviceType])
}

model ClinicSanatoriumService {
  clinicId            String
  sanatoriumServiceId String
  clinicPrice         Int?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  availableFrom       DateTime?
  availableTo         DateTime?
  contactEmail        String?
  contactPhone        String?
  customDescription   String?
  customNameRu        String?
  customNameUz        String?
  discountPercent     Int?              @default(0)
  discountValidUntil  DateTime?
  excludes            Json?
  features            Json?
  includes            Json?
