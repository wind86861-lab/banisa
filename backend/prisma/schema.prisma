// ─── Per-clinic Payme merchant configuration ─────────────────────────────────
// Secret keys are AES-256-GCM encrypted at rest using PAYME_MASTER_KEY (env).
// Plaintext keys never leave the TenantVault service.
model ClinicPaymeConfig {
  id                  String   @id @default(uuid())
  clinicId            String   @unique
  merchantId          String
  // Production secret key, AES-256-GCM encrypted (base64 ciphertext + iv + tag)
  prodKeyCiphertext   String
  prodKeyIv           String
  prodKeyTag          String
  // Optional separate test/sandbox key (Payme sandbox env)
  testKeyCiphertext   String?
  testKeyIv           String?
  testKeyTag          String?
  // Test mode flag — when true, only testKey accepted; prod ignored
  isTestMode          Boolean  @default(true)
  // Active flag — admin/clinic can disable without deleting config
  isActive            Boolean  @default(false)
  // Activation lifecycle
  connectedAt         DateTime?
  lastUsedAt          DateTime?
  lastRotatedAt       DateTime?
  // Last self-test result — used by patchActive as a gate so admins
  // can't flip isActive=true without first proving the URL+keys work.
  lastSelfTestAt      DateTime?
  lastSelfTestStatus  String?   // 'pass' | 'fail'
  lastSelfTestMsg     String?
  // Audit pointers
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinic   Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  versions PaymeConfigVersion[]

  @@index([isActive])
}

// ─── Immutable version history for rollback + compliance ─────────────────────
model PaymeConfigVersion {
  id                String   @id @default(uuid())
  configId          String
  clinicId          String
  version           Int
  merchantId        String
  prodKeyCiphertext String
  prodKeyIv         String
  prodKeyTag        String
  testKeyCiphertext String?
  testKeyIv         String?
  testKeyTag        String?
  isTestMode        Boolean
  reason            String?   // "initial" | "rotation" | "manual" | "incident"
  changedBy         String?
  createdAt         DateTime @default(now())

  config ClinicPaymeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  clinic Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([configId, version])
  @@index([clinicId])
  @@index([createdAt])
}

// ─── Webhook activity log — powers clinic dashboard & troubleshooter ─────────
// Retention: rolling 90 days (sweeper job, future). Per-clinic and per-call.
model PaymeWebhookLog {
  id         String   @id @default(uuid())
  clinicId   String?
  method     String   // Payme JSON-RPC method or "AuthFailed"
  statusCode Int      // 200 always (per Payme spec); 0 if no response sent
  errorCode  Int?     // Payme error code if any
  errorMsg   String?
  orderId    String?
  paymeId    String?
  durationMs Int
  isTestMode Boolean  @default(false)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([clinicId, errorCode])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// CLICK.UZ INTEGRATION — mirrors the Payme models above. Per-clinic merchant
// credentials, transaction tracking, immutable config history, webhook log.
// Secret keys encrypted at rest with the same AES-256-GCM TenantVault as
// Payme (PAYME_MASTER_KEY env).
// ═══════════════════════════════════════════════════════════════════════════

model ClickTransaction {
  id                String   @id @default(uuid())
  clickTransId      String?  @unique
  clickPaydocId     String?
  merchantTransId   String                          // = appointment.id
  merchantPrepareId String?                         // = our ClickTransaction.id, echoed to CLICK after Prepare
  amount            Int                             // som (CLICK uses decimal som, we store as int rounded)
  state             Int      @default(0)            // 0=draft 1=prepared 2=paid -1=cancelled
  signTime          String?
  clinicId          String?
  isTestMode        Boolean  @default(false)
  // SHOP SPLIT audit — how a single payment was divided (null for legacy/non-split txns)
  isSplit           Boolean  @default(false)
  splitBanisaAmount Int?                            // commission → Banisa (Medikal Navigator) counterparty
  splitClinicAmount Int?                            // remainder → clinic counterparty
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinic Clinic? @relation(fields: [clinicId], references: [id])

  @@index([clickTransId])
  @@index([merchantTransId])
  @@index([state])
  @@index([merchantTransId, state])
  @@index([clinicId])
  @@index([clinicId, state])
}

model ClinicClickConfig {
  id                       String   @id @default(uuid())
  clinicId                 String   @unique
  merchantId               String                       // numeric, public
  serviceId                String                       // numeric, public — distinct service per clinic
  merchantUserId           String?                      // for outgoing Merchant API calls
  // Production secret key, AES-256-GCM encrypted
  prodKeyCiphertext        String
  prodKeyIv                String
  prodKeyTag               String
  // Optional sandbox secret key
  testKeyCiphertext        String?
  testKeyIv                String?
  testKeyTag               String?
  isTestMode               Boolean  @default(true)
  isActive                 Boolean  @default(false)
  connectedAt              DateTime?
  lastUsedAt               DateTime?
  lastRotatedAt            DateTime?
  // Self-test status — patchActive uses this as a gate before flipping
  // isActive=true (mirrors ClinicPaymeConfig).
  lastSelfTestAt           DateTime?
  lastSelfTestStatus       String?
  lastSelfTestMsg          String?
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  clinic   Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  versions ClickConfigVersion[]

  @@index([isActive])
}

// ─── SHOP SPLIT ─────────────────────────────────────────────────────────────
// Single Banisa "Split-Shop" merchant. All split payments flow through this one
// service_id; each clinic is a counterparty (cntrg_id) / branch (branch_id) under
// it. Banisa itself (Medikal Navigator, INN 307082044) is the commission
// counterparty. Secret is AES-256-GCM sealed like ClinicClickConfig.
model ClickSplitGlobalConfig {
  id                   String   @id @default(uuid())
  serviceId            String
  merchantId           String
  merchantUserId       String?
  prodKeyCiphertext    String
  prodKeyIv            String
  prodKeyTag           String
  testKeyCiphertext    String?
  testKeyIv            String?
  testKeyTag           String?
  isTestMode           Boolean  @default(true)
  isActive             Boolean  @default(false)
  // Banisa commission counterparty (Medikal Navigator)
  banisaCntrgId        String?
  banisaInn            String?
  banisaBranchId       String?
  banisaPaymentAccount String?
  banisaPaymentMfo     String?
  banisaTransitAccount String?
  banisaTransitMfo     String?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Per-clinic SHOP SPLIT routing — entered/edited by the clinic admin. Holds the
// clinic's Click branch/counterparty id (defaults to its INN) and bank rekvizit
// returned in the Prepare `params`. No secret here — the split flows through the
// global Banisa service.
model ClinicClickSplitConfig {
  id             String   @id @default(uuid())
  clinicId       String   @unique
  inn            String?                       // STIR / ИНН = branch_id default
  branchId       String?                       // Click branch_id (defaults to inn)
  cntrgId        String?                       // Click counterparty id (defaults to inn)
  // Full legal + banking dossier the clinic shares for the Click Split-Shop
  // counterparty contract.
  legalName      String?                       // Юр наименование ("... " MCHJ)
  directorName   String?                       // rahbar / imzo qo'yuvchi
  legalAddress   String?                       // yuridik manzil
  bankName       String?                       // xizmat ko'rsatuvchi bank
  oked           String?                       // OKED faoliyat kodi
  contactPhone   String?                       // shartnoma uchun aloqa (bemorga ko'rinmaydi)
  paymentAccount String?                       // hisob-kitob raqami
  paymentMfo     String?
  transitAccount String?
  transitMfo     String?
  isConfigured   Boolean  @default(false)      // clinic filled the required fields
  isActive       Boolean  @default(false)      // super-admin gate to route split here
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

// ─── Alif (Nasiya) ──────────────────────────────────────────────────────────
// Per-clinic Alif merchant. Each clinic connects its OWN Alif account (NOT a
// shared/split merchant — peer-to-peer). The Token authenticates our outgoing
// invoice-creation calls; the Key (secret) verifies incoming webhook Signature
// (HMAC-SHA256 base64). Both are AES-256-GCM sealed like ClinicClickConfig.
model ClinicAlifConfig {
  id                  String    @id @default(uuid())
  clinicId            String    @unique
  // Production credentials
  prodTokenCiphertext String
  prodTokenIv         String
  prodTokenTag        String
  prodKeyCiphertext   String
  prodKeyIv           String
  prodKeyTag          String
  // Sandbox credentials (optional)
  testTokenCiphertext String?
  testTokenIv         String?
  testTokenTag        String?
  testKeyCiphertext   String?
  testKeyIv           String?
  testKeyTag          String?
  isTestMode          Boolean   @default(true)
  isActive            Boolean   @default(false)
  connectedAt         DateTime?
  lastUsedAt          DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model AlifTransaction {
  id            String   @id @default(uuid())
