  unit             String?
  category         MetadataCategory       @default(MEDICAL_INFO)
  validation       Json?
  visibleToPatient Boolean                @default(true)
  editableBy       EditableBy             @default(CLINIC)
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdBy        String?
  serviceLinks     ServiceMetadataLink[]
  appointmentMetadata AppointmentMetadata[]
  clinicServiceMetadata ClinicServiceMetadata[]

  @@index([isActive])
  @@index([key])
}

model ServiceMetadataLink {
  id           String            @id @default(uuid())
  serviceType  ServiceType
  serviceId    String
  templateId   String
  template     MetadataTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  isRequired   Boolean           @default(false)
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  createdBy    String?

  @@unique([serviceType, serviceId, templateId])
  @@index([serviceType, serviceId])
  @@index([templateId])
}

model AppointmentMetadata {
  id            String            @id @default(uuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  templateId    String
  template      MetadataTemplate  @relation(fields: [templateId], references: [id])
  value         String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdBy     String?

  @@unique([appointmentId, templateId])
  @@index([appointmentId])
  @@index([templateId])
}

// Per-clinic-service metadata values (set by clinic on activation,
// used as filterable attributes in the public catalog). Distinct from
// AppointmentMetadata, which holds per-visit medical data.
model ClinicServiceMetadata {
  id          String           @id @default(uuid())
  clinicId    String
  serviceType ServiceType
  serviceId   String
  templateId  String
  // For NUMBER range templates: `value` = min, `valueMax` = max.
  // For other types: `value` holds the entered value, `valueMax` = null.
  value       String
  valueMax    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  template    MetadataTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([clinicId, serviceType, serviceId, templateId])
  @@index([serviceType, serviceId, templateId, value])
  @@index([clinicId])
  @@index([templateId])
}

enum MetadataInputType {
  NUMBER
  TEXT
  SELECT
  CHECKBOX
  DATE
  TEXTAREA
}

enum MetadataCategory {
  MEDICAL_INFO
  PREPARATION
  RESTRICTION
  ADDITIONAL_INFO
}

enum EditableBy {
  CLINIC
  OPERATOR
  BOTH
}

model OfertaVersion {
  id            String        @id @default(uuid())
  version       String        @unique
  fileUrl       String
  fileName      String?
  isActive      Boolean        @default(false)
  uploadedAt    DateTime       @default(now())
  uploadedById  String?
  appointments  Appointment[]

  @@index([isActive])
}

// ─── Ambulance system (Phase 1: info-only, no online dispatch) ──────────────
model Ambulance {
  id              String           @id @default(uuid())
  clinicId        String
  callSign        String           // e.g. "A-12", "Skoraya-7"
  type            AmbulanceType    @default(BASIC)
  vehicleModel    String?          // "Mercedes Sprinter 2022"
  licensePlate    String?
  capacity        Int              @default(1) // # of patients
  equipment       Json             @default("[]") // ["defibrillator", "ventilator", "monitor", "ekg"]
  status          AmbulanceStatus  @default(OFFLINE)
  // Base location — where the ambulance is parked when idle
  baseLatitude    Float?
  baseLongitude   Float?
  // Real-time location pushed by the dispatcher's Telegram Live Location
  // share (handled by skory.bot.ts's edited_message:location handler).
  // liveLocationUntil = when Telegram says the share expires; the bot
  // refreshes this on every incoming live update.
  currentLatitude  Float?
  currentLongitude Float?
  liveLocationUntil DateTime?
  lastStatusAt     DateTime?
  // Legacy flat pricing (fallback when no per-band tariff is filled).
  baseFee         Int?             // som — chaqiruv narxi
  pricePerKm      Int?             // som per km
  // Waiting fee — charged per minute the ambulance stands by during a trip
  // (e.g. waits at a clinic while the patient is seen, then returns them).
  // The dispatcher starts/stops the timer from the bot; null = not offered.
  waitingRatePerMin Int?           // som per minute
  // Dedicated dispatch phone (optional — falls back to clinic.phones)
  dispatchPhone   String?
  photoUrl        String?
  notes           String?
  isActive        Boolean          @default(true)
  // Online dispatch: each ambulance has exactly one user who receives the
  // bot offer messages. The clinic admin sets dispatcherPhone when creating
  // the ambulance; we resolve it to dispatcherUserId when that user shows
  // up in our User table (via web sign-up or bot contact-share).
  dispatcherPhone   String?
  dispatcherUserId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  clinic         Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  dispatcher     User?                 @relation("AmbulanceDispatcher", fields: [dispatcherUserId], references: [id], onDelete: SetNull)
  statusLogs     AmbulanceStatusLog[]
  requests       AmbulanceRequest[]
  dispatchOffers DispatchOffer[]
  reviews        AmbulanceReview[]
  bandTariffs    AmbulanceBandTariff[]

  @@index([clinicId])
  @@index([status])
  @@index([type])
  @@index([isActive])
  @@index([dispatcherUserId])
  @@unique([clinicId, callSign])
}

// Patient-initiated tez-yordam request. Lives until a dispatcher accepts
// (transitions to DISPATCHED) or the patient cancels. No hard timeout —
// status of every still-PENDING request is shown to dispatchers indefinitely.
model AmbulanceRequest {
  id                  String                @id @default(uuid())
  patientId           String
  status              AmbulanceRequestStatus @default(PENDING)
  // Which service the patient asked for. Null on legacy rows created before
  // the two-tier split; treated as BASIC everywhere.
  type                AmbulanceType?
  pickupLat           Float
  pickupLng           Float
  pickupAddress       String?
  destLat             Float?
  destLng             Float?
  destAddress         String?
  destClinicId        String?
  priceMaxSom         Int?                  // null = cheklovsiz
  estimatedDistanceKm Float?
  estimatedDurationMin Int?
  description         String?
  // Waiting timer (dispatcher-controlled from the bot). waitingFee =
  // waitingMinutes × ambulance.waitingRatePerMin, added to the trip price.
  waitingStartedAt    DateTime?
  waitingEndedAt      DateTime?
  waitingMinutes      Int?
  waitingFee          Int?
  waitingRemindStage  Int       @default(0)  // # of "still waiting?" pings sent
  // Payment (opened when the dispatcher marks DELIVERED). tripFee + waitingFee
  // = totalPrice. paymentStatus: UNPAID | PAID. paymentMethod: CASH | CLICK |
  //  PAYME | ALIF (whichever the ambulance's clinic offers + patient picked).
  tripFee             Int?
  totalPrice          Int?
  paymentStatus       String    @default("UNPAID")
  paymentMethod       String?
  paidAmount          Int?
  paidAt              DateTime?
  // Online payments reuse the existing per-clinic provider (Payme/Click/Alif)
  // through a bridge Appointment; the skory page reconciles PAID from it. Kept
  // out of clinic dashboards via the [SKORY] notes marker.
  paymentAppointmentId String?
  acceptedAmbulanceId String?
  acceptedAt          DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  patient            User              @relation("PatientAmbulanceRequests", fields: [patientId], references: [id])
  acceptedAmbulance  Ambulance?        @relation(fields: [acceptedAmbulanceId], references: [id])
  destClinic         Clinic?           @relation("AmbulanceRequestDestClinic", fields: [destClinicId], references: [id])
  offers             DispatchOffer[]
  review             AmbulanceReview?

  @@index([patientId])
  @@index([status])
  @@index([acceptedAmbulanceId])
  @@index([createdAt])
}

// One fanout entry per (request, ambulance dispatcher). Holds the Telegram
// message id so we can edit it in place when the request is won/cancelled.
model DispatchOffer {
  id                String              @id @default(uuid())
  requestId         String
  ambulanceId       String
  dispatcherUserId  String
  status            DispatchOfferStatus @default(SHOWN)
  telegramChatId    BigInt?
  telegramMessageId BigInt?
  sentAt            DateTime            @default(now())
  respondedAt       DateTime?

  request    AmbulanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  ambulance  Ambulance        @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)
  dispatcher User             @relation("DispatcherOffers", fields: [dispatcherUserId], references: [id])

  @@unique([requestId, ambulanceId])
  @@index([requestId])
  @@index([dispatcherUserId])
  @@index([status])
}

enum AmbulanceRequestStatus {
  PENDING       // ko'rsatildi, hech kim qabul qilmadi
  DISPATCHED    // ambulans qabul qildi, yo'lda
  ON_ROUTE      // bemor tomon harakatda (manual update)
  ARRIVED       // bemor oldida
  PICKED_UP     // bemorni oldi, manzilga olib ketyapti
  DELIVERED     // bemorni manzilga yetkazdi (to'lov kutilmoqda)
  COMPLETED     // yakunlandi (to'landi)
  CANCELLED     // bemor yoki dispatcher bekor qildi
}

enum DispatchOfferStatus {
  SHOWN     // yuborildi, javob kutilmoqda
  ACCEPTED  // ushbu offer g'olib bo'ldi
  LOST      // boshqa offer qabul qilindi
  DECLINED  // dispatcher rad etdi
}

// Audit + history of status transitions (for stale detection + compliance)
model AmbulanceStatusLog {
  id          String          @id @default(uuid())
  ambulanceId String
  fromStatus  AmbulanceStatus?
  toStatus    AmbulanceStatus
  changedBy   String?
  reason      String?
  createdAt   DateTime         @default(now())

  ambulance Ambulance @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)

  @@index([ambulanceId])
  @@index([createdAt])
}

enum AmbulanceType {
  BASIC            // umumiy
  INTENSIVE_CARE   // reanimatsiya
  NEONATAL         // yangi tug'ilgan bolalar
  CARDIAC          // yurak
  TRAUMA           // travmatologiya
  OBSTETRIC        // tug'ruq
}

enum AmbulanceStatus {
  AVAILABLE   // bo'sh ("pustoy")
  BUSY        // chaqiruvda
  MAINTENANCE // texnik xizmat
  OFFLINE     // smenadan tashqari
}

// Singleton (one row) global defaults set by SUPER_ADMIN. Used when a
// clinic creates an ambulance without filling its own price fields —
// the missing values are back-filled from here before the row is saved.
// If neither this nor the clinic's own value is set, the ambulance cannot
// be activated (status=AVAILABLE).
model GlobalAmbulanceSettings {
  id                  String   @id @default(uuid())
  defaultPricePerKm   Int?     // som per km
  defaultBaseFee      Int?     // som — chaqiruv narxi
  updatedBy           String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

// Patient review left after a completed ambulance trip. One review per
// request; the patient owns it. Rating 1-5 + optional comment.
model AmbulanceReview {
  id          String   @id @default(uuid())
  requestId   String   @unique
  patientId   String
  ambulanceId String
  clinicId    String
  rating      Int      // 1-5
  comment     String?
  createdAt   DateTime @default(now())

  request   AmbulanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  patient   User             @relation("PatientAmbulanceReviews", fields: [patientId], references: [id])
  ambulance Ambulance        @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)
  clinic    Clinic           @relation("ClinicAmbulanceReviews", fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([ambulanceId])
  @@index([clinicId])
  @@index([patientId])
  @@index([createdAt])
}

// ─── Tez-yordam distance-band pricing ────────────────────────────────────────
// SUPER_ADMIN-managed distance bands. The patient's TRIP distance
// (pickup→destination) selects exactly one band; the accepting ambulance's
// per-band tariff (base + per-km) then prices that trip. Bands are dynamic:
// admin adds/edits them as the market changes, and each ambulance fills one
// tariff row per band. A tapering band table (cheaper per-km at longer
// distances) keeps long trips fair without punishing the patient for how far
// the ambulance had to travel to reach them.
model AmbulancePricingBand {
  id        String   @id @default(uuid())
  label     String                       // "Yaqin", "O'rta", "Uzoq"
  minKm     Float    @default(0)         // inclusive lower bound (km)
  maxKm     Float?                        // exclusive upper bound; null = ∞
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tariffs AmbulanceBandTariff[]

  @@index([isActive, sortOrder])
}

// One ambulance's price for one band. A missing row means the ambulance has
// no price for that band → the vehicle's legacy flat baseFee/pricePerKm is
// used as a fallback so pre-band ambulances keep working.
model AmbulanceBandTariff {
  id          String   @id @default(uuid())
  ambulanceId String
  bandId      String
  baseFee     Int                          // som — boshlang'ich narx
  pricePerKm  Int                          // som per km
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ambulance Ambulance            @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)
  band      AmbulancePricingBand @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@unique([ambulanceId, bandId])
  @@index([bandId])
}

// ─── Clinic team / RBAC ──────────────────────────────────────────────────────
// Granular permissions so every clinic action can be governed by which
// role(s) hold the matching permission. Default roles (OWNER / MANAGER /
// RECEPTIONIST / CASHIER / DOCTOR / ACCOUNTANT) are seeded as `isSystem` rows
// on clinic creation; owners can also define custom roles per clinic by
// picking from this enum.
enum ClinicPermission {
  // Bookings
  BOOKING_VIEW
  BOOKING_ACCEPT
  BOOKING_RESCHEDULE

  // Patients
  PATIENT_VIEW
  PATIENT_CONTACT           // phone / e-mail (PII)

  // Payments
  PAYMENT_VIEW
  PAYMENT_CONFIRM_CASH

  // Team
  TEAM_VIEW
  TEAM_INVITE
  TEAM_REMOVE
  TEAM_ROLE_CHANGE

  // Reports
  REPORTS_DAILY
  REPORTS_EXPORT

  // Clinic configuration (write). Held by CLINIC_ADMIN, not DIRECTOR, so the
  // read-only director role can view but not mutate these surfaces.
  SERVICE_MANAGE            // activate/customize services + images + packages
  DOCTOR_MANAGE             // attach/edit/remove doctors + schedules
  AMBULANCE_MANAGE          // clinic ambulance fleet CRUD
  CLINIC_SETTINGS_EDIT      // clinic profile + working hours + queue settings
}

/// Per-clinic role definition. Default system roles are seeded automatically
/// (see seedClinicRoles in the migration). isSystem rows can't be renamed or
/// deleted via the team API.
model ClinicRole {
  id          String             @id @default(uuid())
  clinicId    String
  name        String
  description String?
  permissions ClinicPermission[]
  isSystem    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  clinic      Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  memberships ClinicMembership[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

/// Links a User to a Clinic with a role. A single user may be a member of
/// many clinics (multi-clinic switching is supported); a clinic has many
/// members. The legacy User.clinicId column is kept as the user's "default"
/// clinic for backwards compatibility with code that still reads it; new
/// queries should resolve membership via this table.
model ClinicMembership {
  id         String   @id @default(uuid())
  clinicId   String
  userId     String
  roleId     String
  invitedBy  String?
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime?
  isActive   Boolean  @default(true)

  clinic     Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ClinicRole @relation(fields: [roleId], references: [id])
  invitedByUser User?   @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@unique([clinicId, userId])
  @@index([clinicId])
  @@index([userId])
  @@index([isActive])
}

/// Append-only history of significant clinic actions. Used by /audit view
/// (AUDIT_VIEW permission) so owners can trace who confirmed a payment,
/// changed a role, removed a member, etc.
model ClinicAuditLog {
  id        String   @id @default(uuid())
  clinicId  String
  actorId   String?
  action    String   // e.g. "booking.accept", "team.invite", "payment.confirm_cash"
  targetType String? // e.g. "appointment", "user", "service"
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  clinic    Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  actor     User?  @relation("ClinicAuditActor", fields: [actorId], references: [id])

  @@index([clinicId, createdAt])
  @@index([actorId])
  @@index([action])
}
