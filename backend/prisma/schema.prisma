/// Per-user notification channel preferences. Channels JSON shape:
/// { [eventType]: ["inapp" | "sms" | "telegram"] }
/// Unknown events fall back to defaults defined in code (see notification_defaults.ts).
model NotificationPreference {
  id         String   @id @default(uuid())
  userId     String   @unique
  channels   Json     @default("{}")
  smsConsent Boolean  @default(true)
  tgConsent  Boolean  @default(false)
  language   String   @default("uz")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Binds a Telegram chat to a Banisa user. One user → one chat (unique).
/// chatId is BigInt — Telegram chat ids can exceed 32-bit range.
model TelegramAccount {
  id             String   @id @default(uuid())
  userId         String   @unique
  chatId         BigInt   @unique
  telegramUserId BigInt   @unique
  username       String?
  firstName      String?
  language       String   @default("uz")
  isBlocked      Boolean  @default(false)
  linkedAt       DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  // Multi-clinic users pick which clinic the bot keyboard acts against
  // via /switch_clinic. NULL = use the first active membership.
  activeClinicId String?
  // Bot conversational state — set by wizards (patient search, booking,
  // reschedule). Cleared when the wizard advances/finishes/cancels. Keeps
  // multi-step flows resilient across restarts without a separate session
  // store. Shape: { kind: 'search'|'reschedule:<id>'|'booking:<step>', data?: any }.
  wizardState   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isBlocked])
}

/// Short-lived single-use token for binding a Telegram chat to a user.
/// Generated when patient clicks "Link Telegram" on web; consumed by
/// the bot when patient sends /start <token>.
model TelegramLoginToken {
  token     String   @id
  userId    String
  purpose   String   @default("link") // 'link' | 'login' | 'reset'
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Delivery log — one row per channel attempt, including skipped ones.
/// Used to debug delivery, enforce per-user SMS rate limits, and feed analytics.
model NotificationLog {
  id           String   @id @default(uuid())
  userId       String?
  clinicId     String?
  eventType    String
  channel      String
  status       String
  errorMessage String?
  externalId   String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([channel, createdAt])
  @@index([eventType, createdAt])
}

